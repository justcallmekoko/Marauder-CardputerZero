"""Inventory physical radios and change only the chosen device."""
from dataclasses import dataclass
from pathlib import Path
import hashlib
import json
import os
import re
import stat
import socket
import struct
import subprocess
import sys
import time
import tempfile

SYS = Path("/sys/class")

def text(path):
    try:
        return path.read_text().strip()
    except OSError:
        return ""

def bus_info(path):
    for parent in [path, *path.parents]:
        if (parent / "idVendor").exists():
            ids = text(parent / "idVendor") + ":" + text(parent / "idProduct")
            return "External USB", text(parent / "product"), ids
    if "/platform/" in str(path):
        return "Internal", "", ""
    return "Unknown bus", "", ""

def hardware_identity(node, physical):
    # USB tty, hci and phy numbers can change between launches.
    for parent in (physical, *physical.parents):
        if not (parent / "idVendor").exists():
            continue
        vendor = text(parent / "idVendor")
        product = text(parent / "idProduct")
        serial = text(parent / "serial")
        interface = next((text(p / "bInterfaceNumber") for p in (physical, *physical.parents)
                          if (p / "bInterfaceNumber").exists()), "")
        location = serial if serial and serial.strip("0") else str(parent)
        port = text(node / "device/port_number")
        return "|".join((vendor, product, location, interface, port))
    return str(physical)

@dataclass
class Device:
    kind: str
    name: str
    location: str
    product: str
    driver: str
    detail: str
    state: str
    identity: str
    switch: str = ""

    @property
    def key(self):
        return hashlib.sha256((self.kind + ":" + self.identity).encode()).hexdigest()

def gps_devices():
    try:
        with socket.create_connection(("127.0.0.1", 2947), timeout=1) as sock:
            sock.settimeout(1)
            sock.sendall(b"?DEVICES;\n")
            with sock.makefile("rb") as stream:
                for _ in range(4):
                    packet = json.loads(stream.readline(65536))
                    if packet.get("class") == "DEVICES":
                        return {str(Path(d["path"]).resolve()): d for d in packet["devices"]
                                if d.get("path","").startswith("/dev/")}
    except (OSError, ValueError, KeyError):
        pass
    return None

def inventory():
    devices = []
    switches = {text(r / "name"): r for r in (SYS / "rfkill").glob("rfkill*")}
    for kind, nodes in [("WiFi", (SYS / "net").glob("*")), ("Bluetooth", (SYS / "bluetooth").glob("hci*"))]:
        for node in sorted(nodes):
            if kind == "WiFi" and not ((node / "wireless").exists() or (node / "phy80211").exists()):
                continue
            physical = (node / "device").resolve()
            location, product, ids = bus_info(physical)
            phy = (node / "phy80211").resolve().name if kind == "WiFi" else node.name
            switch = switches.get(phy)
            state = "Unknown"
            if switch:
                state = "Locked" if text(switch/"hard") == "1" else "Off" if text(switch/"soft") == "1" else "On"
            if kind == "Bluetooth" and state == "On":
                state = bluetooth_power(node.name)
            driver = (physical / "driver").resolve().name if (physical / "driver").exists() else ""
            devices.append(Device(kind,node.name,location,product or ("WiFi adapter" if kind=="WiFi" else "Bluetooth controller"),
                                  driver or phy, "  ".join(filter(None,[ids,text(node/"address")])),state,
                                  hardware_identity(node, physical),str(switch or "")))
    devices.extend(gps_ports(gps_devices()))
    return devices

def gps_ports(attached):
    devices = []
    ports = {Path(raw) for raw in (attached or {})}
    ports.update(Path("/dev").glob("gnss[0-9]*"))
    ports.update(Path("/dev").glob("ttyACM[0-9]*"))
    ports.update(Path("/dev").glob("ttyUSB[0-9]*"))
    uart = Path("/dev/serial0")
    if uart.exists():
        ports.add(uart.resolve())
    for port in sorted({p.resolve() for p in ports}):
        if not port.is_char_device() or port.name in text(SYS/"tty/console/active").split():
            continue
        physical = (SYS / ("gnss" if port.name.startswith("gnss") else "tty") / port.name / "device").resolve()
        location, product, ids = bus_info(physical)
        if port == uart.resolve():
            location = "External UART"
        if port == Path("/dev/serial1").resolve() or ids == "303a:1001":
            continue
        record = (attached or {}).get(str(port), {})
        confirmed = record.get("driver") or port.name.startswith("gnss")
        devices.append(Device("GPS",port.name,location,record.get("driver") or product or "Serial receiver port",
                              "GPS receiver" if confirmed else "Unverified GPS port",ids or str(port),
                              "Off",
                              hardware_identity(SYS / "tty" / port.name, physical),record.get("path","")))
    return devices

def bluetooth_power(name):
    result = subprocess.run(["/usr/bin/busctl","--system","--timeout=1","get-property","org.bluez",
                             "/org/bluez/"+name,"org.bluez.Adapter1","Powered"],capture_output=True,text=True)
    return {"b true":"On","b false":"Off"}.get(result.stdout.strip(),"Unknown")

def change(device, enable):
    if device.state not in ("On","Off") or not device.switch:
        raise ValueError("Device unavailable")
    if (device.state == "On") == enable:
        return
    if device.kind == "GPS":
        raise ValueError("GPS is session-local")
    set_soft(device, not enable)
    if device.kind == "Bluetooth" and enable:
        set_power(device, True)

def set_soft(device, blocked):
    index = int(Path(device.switch).name.removeprefix("rfkill"))
    with open("/dev/rfkill", "wb", buffering=0) as f:
        f.write(struct.pack("=IBBBB", index, 0, 2, int(blocked), 0))

def set_power(device, enabled):
    for _ in range(8):
        result = subprocess.run(["/usr/bin/busctl", "--system", "--timeout=1", "set-property",
                                 "org.bluez", "/org/bluez/"+device.name, "org.bluez.Adapter1",
                                 "Powered", "b", "true" if enabled else "false"], capture_output=True)
        if result.returncode == 0:
            return
        time.sleep(.15)
    raise OSError("Bluetooth power change failed")

def snapshot(directory, devices):
    for d in devices:
        if not d.switch or d.kind == "GPS":
            continue
        saved = directory / d.key
        if saved.exists():
            continue
        soft = text(Path(d.switch) / "soft")
        power = bluetooth_power(d.name) if d.kind == "Bluetooth" and soft == "0" else "-"
        if soft in ("0", "1") and power in ("On", "Off", "-"):
            saved.write_text(soft + " " + power)

def apply(device, enabled, directory):
    if directory and device.state in ("On", "Off") and (device.state == "On") != enabled:
        if not (directory / device.key).is_file():
            raise ValueError("No original radio state")
        (directory / (device.key + ".changed")).touch()
    change(device, enabled)

def release(directory):
    devices = {d.key: d for d in inventory() if d.kind != "GPS"}
    ok = True
    for marker in directory.glob("*.changed"):
        d = devices.get(marker.stem)
        if not d or not d.switch:
            continue
        try:
            soft, power = (directory / d.key).read_text().split()
            if text(Path(d.switch) / "soft") != soft:
                set_soft(d, soft == "1")
            if d.kind == "Bluetooth" and power in ("On", "Off") and bluetooth_power(d.name) != power:
                set_power(d, power == "On")
            for _ in range(5):
                if text(Path(d.switch) / "soft") == soft and (power == "-" or bluetooth_power(d.name) == power):
                    break
                time.sleep(.1)
            else:
                ok = False
        except (ValueError, OSError, subprocess.SubprocessError):
            ok = False
    for file in directory.iterdir():
        if re.fullmatch(r"[0-9a-f]{64}(?:\.changed)?", file.name):
            file.unlink()
    return ok

def preference_file(device):
    root = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config")
    return root / "marauder-cardputerzero" / "radio-states" / device.key

def remember(device, action):
    path = preference_file(device)
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    out = tempfile.NamedTemporaryFile(mode="w", dir=path.parent, delete=False)
    temp = Path(out.name)
    try:
        with out:
            out.write(action)
            out.flush()
            os.fsync(out.fileno())
        os.replace(temp, path)
    finally:
        temp.unlink(missing_ok=True)

def restore(devices, directory=None):
    requested = {}
    for d in devices:
        if d.kind == "GPS":
            continue
        wanted = text(preference_file(d))
        if wanted not in ("on", "off") or d.state.lower() == wanted:
            continue
        requested[d.key] = wanted
        try:
            apply(d, wanted == "on", directory)
        except (ValueError, OSError, subprocess.SubprocessError):
            continue
    if not requested:
        return devices, ""
    for _ in range(4):
        devices = inventory()
        states = {d.key: d.state.lower() for d in devices}
        if all(states.get(key) == wanted for key, wanted in requested.items()):
            return devices, "Settings restored"
        time.sleep(.15)
    return devices, "Restore incomplete"

def emit(fields):
    print("\t".join(" ".join(str(x).split())[:180] for x in fields))

if __name__=="__main__":
    directory = None
    args = sys.argv[1:]
    if len(args) >= 2 and args[0] == "--session":
        directory = Path(args[1])
        if directory.parent != Path("/tmp") or not re.fullmatch(r"marauder-radios-[A-Za-z0-9]{6}", directory.name):
            sys.exit("Invalid radio session")
        info = directory.lstat()
        if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o077:
            sys.exit("Invalid session ownership")
        args = args[2:]
    if args == ["--release"] and directory is not None:
        sys.exit(0 if release(directory) else 1)
    result=""
    devices=inventory()
    if directory:
        snapshot(directory, devices)
    if args == ["--restore"]:
        devices, result = restore(devices, directory)
    if len(args)==2:
        key,action=args
        device=next((d for d in devices if d.key==key),None)
        try:
            if device is None or action not in ("on","off"):
                raise ValueError("Device changed")
            apply(device,action=="on",directory)
            for _ in range(4):
                devices=inventory()
                if any(d.key==key and d.state.lower()==action for d in devices):
                    try:
                        remember(device, action)
                        result=device.name+" "+("enabled" if action=="on" else "disabled")
                    except OSError:
                        result="Changed but not saved"
                    break
                time.sleep(.15)
            if not result: result="State unconfirmed"
        except (OSError,ValueError,subprocess.SubprocessError):
            result="Change failed"
            devices=inventory()
    emit(["status",result or "Ready"])
    for d in devices:
        emit(["radio",d.key,d.kind,d.name,d.location,d.product,d.driver,d.detail,d.state])
