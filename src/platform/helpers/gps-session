"""Read the selected GPS until the owning app closes stdin."""
import contextlib
import errno
import fcntl
import json
import os
from pathlib import Path
import re
import select
import socket
import sys
import termios
import time
import tty

class SessionEnded(Exception):
    pass

def ready(fd=None, timeout=0):
    readers = [0] if fd is None else [0, fd]
    events, _, _ = select.select(readers, [], [], timeout)
    if 0 in events:
        raise SessionEnded
    return fd in events

last_status = None

def report(value):
    global last_status
    if value != last_status:
        print(value, flush=True)
        last_status = value

class FixStatus:
    def __init__(self):
        self.fixed = False
        self.count = None
        self.count_time = 0
        self.groups = {}
        self.position = None
        self.position_time = 0

    def set_position(self, latitude, longitude):
        if -90 <= latitude <= 90 and -180 <= longitude <= 180 and (latitude or longitude):
            self.position = (round(latitude * 10_000_000), round(longitude * 10_000_000))
            self.position_time = time.monotonic()

    def line(self, label):
        if self.fixed and self.position and time.monotonic() - self.position_time < 10:
            return f"{label}\t{self.position[0]}\t{self.position[1]}"
        return label

    def update(self, fixed=None, count=None):
        if fixed is not None:
            self.fixed = fixed
        if fixed is False:
            self.count = None
            self.groups.clear()
            self.position = None
        elif isinstance(count, int) and 0 <= count <= 255:
            self.count = count
            self.count_time = time.monotonic()
        if not self.fixed:
            return "No fix"
        if self.count is not None and time.monotonic() - self.count_time < 10:
            return self.line(f"{self.count} sat")
        now = time.monotonic()
        active = [ids for ids, stamp in self.groups.values() if now - stamp < 2.5]
        if active:
            return self.line(f"{sum(map(len, active))} sat")
        return self.line("Fix")

def nmea_coordinate(value, hemisphere, degrees):
    if not value or hemisphere not in (b"N", b"S", b"E", b"W"):
        return None
    try:
        text = value.decode("ascii")
        if len(text) < degrees + 2:
            return None
        number = int(text[:degrees]) + float(text[degrees:]) / 60
        return -number if hemisphere in (b"S", b"W") else number
    except (UnicodeDecodeError, ValueError):
        return None

def fix(sentence, status):
    match = re.fullmatch(rb"\$([A-Z]{2}(GGA|RMC|GSA),[^*]*)\*([\da-fA-F]{2})", sentence.strip())
    if not match:
        return None
    total = 0
    for byte in match[1]:
        total ^= byte
    if total != int(match[3], 16):
        return None
    fields = match[1].split(b",")
    if match[2] == b"GSA" and len(fields) >= 3:
        if fields[2] in (b"1", b"2", b"3"):
            if fields[2] != b"1" and len(fields) >= 15:
                group = fields[18] if len(fields) > 18 and fields[18] else fields[0][:2]
                ids = {sv for sv in fields[3:15] if sv.isdigit() and int(sv)}
                if ids:
                    status.groups[group] = (ids, time.monotonic())
            return status.update(fields[2] != b"1")
    if match[2] == b"RMC" and len(fields) >= 3:
        if fields[2] in (b"A", b"V"):
            if fields[2] == b"A" and len(fields) >= 7:
                lat = nmea_coordinate(fields[3], fields[4], 2)
                lon = nmea_coordinate(fields[5], fields[6], 3)
                if lat is not None and lon is not None:
                    status.set_position(lat, lon)
            return status.update(fields[2] == b"A")
    if match[2] == b"GGA" and len(fields) >= 7 and fields[6].isdigit():
        if int(fields[6]) and len(fields) >= 6:
            lat = nmea_coordinate(fields[2], fields[3], 2)
            lon = nmea_coordinate(fields[4], fields[5], 3)
            if lat is not None and lon is not None:
                status.set_position(lat, lon)
        count = int(fields[7]) if len(fields) > 7 and fields[7].isdigit() else None
        return status.update(bool(int(fields[6])), count)

@contextlib.contextmanager
def supply(uart):
    changed = []
    try:
        if uart:
            for name in ("ext_5v_out", "grove_5v_out"):
                node = Path("/sys/class/leds") / name / "brightness"
                if node.exists() and node.read_text().strip() == "0":
                    node.write_text("1")
                    changed.append(node)
            if changed:
                ready(timeout=1.5)
        yield
    finally:
        for node in reversed(changed):
            with contextlib.suppress(OSError):
                node.write_text("0")

def serial_status(port, uart):
    fd = os.open(port, os.O_RDONLY | os.O_NOCTTY | os.O_NONBLOCK)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        saved = termios.tcgetattr(fd)
        try:
            with supply(uart):
                for speed in (termios.B115200, termios.B9600, termios.B38400, termios.B460800):
                    settings = saved.copy()
                    settings[6] = saved[6].copy()
                    tty.cfmakeraw(settings)
                    settings[4] = settings[5] = speed
                    termios.tcsetattr(fd, termios.TCSANOW, settings)
                    deadline = time.monotonic() + 3
                    buf = b""
                    status = FixStatus()
                    while time.monotonic() < deadline:
                        if not ready(fd, .3):
                            continue
                        data = os.read(fd, 2048)
                        if not data:
                            raise OSError(errno.ENODEV, "Disconnected")
                        buf += data
                        while b"\n" in buf:
                            line, buf = buf.split(b"\n", 1)
                            value = fix(line, status)
                            if value:
                                report(value)
                                deadline = time.monotonic() + 5
                        buf = buf[-512:]
                    report("No data")
        finally:
            with contextlib.suppress(OSError, termios.error):
                termios.tcsetattr(fd, termios.TCSANOW, saved)
    finally:
        os.close(fd)

def shared_status(port, path):
    with socket.create_connection(("127.0.0.1", 2947), timeout=1) as sock:
        watch = {"enable": True, "json": True, "device": path}
        sock.sendall(("?WATCH=" + json.dumps(watch, separators=(",", ":")) + ";\n").encode())
        status = FixStatus()
        buf = b""
        deadline = time.monotonic() + 5
        while time.monotonic() < deadline:
            if not ready(sock, .3):
                continue
            chunk = sock.recv(8192)
            if not chunk:
                break
            buf += chunk
            while b"\n" in buf:
                line, buf = buf.split(b"\n", 1)
                msg = json.loads(line)
                if Path(msg.get("device", "")).resolve() != port:
                    continue
                if msg.get("class") == "SKY":
                    count = msg.get("uSat")
                    if count is None and isinstance(msg.get("satellites"), list):
                        count = len({(s.get("gnssid"), s.get("svid", s.get("PRN"))) for s in msg["satellites"]
                                     if s.get("used") and ("svid" in s or "PRN" in s)})
                    value = status.update(count=count)
                    if status.fixed:
                        report(value)
                if msg.get("class") == "TPV":
                    mode = msg.get("mode")
                    if mode in (1, 2, 3):
                        if mode >= 2 and isinstance(msg.get("lat"), (int, float)) and isinstance(msg.get("lon"), (int, float)):
                            status.set_position(msg["lat"], msg["lon"])
                        report(status.update(mode >= 2))
                        deadline = time.monotonic() + 5
            if len(buf) > 65536:
                break
        report("No data")

def main(key):
    import runpy
    api = runpy.run_path(str(Path(__file__).with_name("radio-inventory")))
    while True:
        ready()
        ports = api["gps_ports"](api["gps_devices"]())
        selected = next((p for p in ports if p.key == key), None)
        if selected is None:
            report("Missing")
        else:
            port = Path("/dev") / selected.name
            report("Wait")
            try:
                if selected.switch:
                    shared_status(port, selected.switch)
                elif port.name.startswith("gnss"):
                    report("Needs gpsd")
                else:
                    serial_status(port, selected.location == "External UART")
            except PermissionError:
                report("Denied")
            except BlockingIOError:
                report("Busy")
            except (OSError, ValueError, termios.error):
                report("Unavailable")
        ready(timeout=1)

if __name__ == "__main__":
    try:
        main(sys.argv[1])
    except (SessionEnded, BrokenPipeError):
        pass
