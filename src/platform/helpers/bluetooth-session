#!/usr/bin/python3 -I
# SPDX-License-Identifier: AGPL-3.0-only
"""Stream live BlueZ discovery sightings until the owning app closes stdin."""
import re
import sys

import dbus
import dbus.mainloop.glib
from gi.repository import GLib


def clean(value):
    return "".join(c if 32 <= ord(c) < 127 else " " for c in str(value))[:48].strip()


def main(adapter):
    if not re.fullmatch(r"hci[0-9]{1,3}", adapter):
        raise ValueError("Invalid Bluetooth adapter")
    dbus.mainloop.glib.DBusGMainLoop(set_as_default=True)
    bus = dbus.SystemBus()
    path = "/org/bluez/" + adapter
    controller = dbus.Interface(bus.get_object("org.bluez", path), "org.bluez.Adapter1")
    properties = dbus.Interface(bus.get_object("org.bluez", path), "org.freedesktop.DBus.Properties")
    if not properties.Get("org.bluez.Adapter1", "Powered"):
        raise ValueError("Bluetooth adapter is off")
    loop = GLib.MainLoop()

    def emit(device_path, changed):
        if "RSSI" not in changed:
            return
        try:
            info = dbus.Interface(bus.get_object("org.bluez", device_path),
                                  "org.freedesktop.DBus.Properties").GetAll("org.bluez.Device1")
            address = str(info.get("Address", "")).upper()
            if not re.fullmatch(r"(?:[0-9A-F]{2}:){5}[0-9A-F]{2}", address):
                return
            name = clean(info.get("Name", ""))
            kind = clean(info.get("AddressType", "unknown"))
            print(f"device\t{address}\t{name}\t{int(changed['RSSI'])}\t{kind}", flush=True)
        except dbus.DBusException:
            pass

    def changed(interface, values, invalidated, device_path=None):
        if interface == "org.bluez.Device1" and device_path and device_path.startswith(path + "/"):
            emit(device_path, values)

    def added(device_path, interfaces):
        if device_path.startswith(path + "/") and "org.bluez.Device1" in interfaces:
            emit(device_path, interfaces["org.bluez.Device1"])

    def closed(source, condition):
        if condition & (GLib.IO_HUP | GLib.IO_ERR) or not sys.stdin.buffer.read(1):
            loop.quit()
            return False
        return True

    bus.add_signal_receiver(changed, dbus_interface="org.freedesktop.DBus.Properties",
                            signal_name="PropertiesChanged", path_keyword="device_path")
    bus.add_signal_receiver(added, dbus_interface="org.freedesktop.DBus.ObjectManager",
                            signal_name="InterfacesAdded")
    GLib.io_add_watch(0, GLib.IO_IN | GLib.IO_HUP | GLib.IO_ERR, closed)
    controller.SetDiscoveryFilter({"Transport": dbus.String("auto"),
                                   "DuplicateData": dbus.Boolean(True)})
    started = False
    try:
        controller.StartDiscovery()
        started = True
        print("status\tScanning", flush=True)
        loop.run()
    finally:
        try:
            if started:
                controller.StopDiscovery()
        finally:
            controller.SetDiscoveryFilter({})


if __name__ == "__main__":
    try:
        if len(sys.argv) != 2:
            raise ValueError("Bluetooth adapter required")
        main(sys.argv[1])
    except (ValueError, dbus.DBusException) as error:
        print("status\t" + clean(error), flush=True)
        sys.exit(1)
